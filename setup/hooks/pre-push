#!/usr/bin/env bash
#
# Pre-push hook: runs the fast test suite before allowing a push.
# If tests fail, the push is aborted.
#
# Long-running tests are skipped here. Run them occasionally with:
#   ./run_all_tests.bash
#
# To bypass this hook (use sparingly!): git push --no-verify
#

set -e

# Get the root of the git repository
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Drain push refs so git does not block on unused stdin
cat >/dev/null

echo ""
echo "╔══════════════════════════════════════════════════════════════════════════╗"
echo "║              PRE-PUSH HOOK: Running fast tests...                        ║"
echo "║  Full suite (occasional): ./run_all_tests.bash                           ║"
echo "╚══════════════════════════════════════════════════════════════════════════╝"
echo ""

# Run the fast test suite (skips additions/mintpy tests and test_minsarApp_options.bash)
if ! bash "$REPO_ROOT/run_all_tests.bash" --fast; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════════════════╗"
    echo "║  PUSH BLOCKED: Tests failed. Fix the issues and try again.              ║"
    echo "║  Rerun: bash \"$REPO_ROOT/run_all_tests.bash\" --fast -v                  ║"
    echo "║  Full suite: bash \"$REPO_ROOT/run_all_tests.bash\"                       ║"
    echo "║  To bypass (use sparingly!): git push --no-verify                       ║"
    echo "╚══════════════════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

echo ""
echo "╔══════════════════════════════════════════════════════════════════════════╗"
echo "║  PRE-PUSH HOOK: All tests passed. Proceeding with push...               ║"
echo "╚══════════════════════════════════════════════════════════════════════════╝"
echo ""

exit 0
