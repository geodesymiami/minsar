######################################################
ssaraopt.platform                    = ALOS2  #[ALOS2 / ALOS-2], download and stack sensor
ssaraopt.relativeOrbit               = 0  #[int], filled from coverage for the AOI
ssaraopt.startDate                   = auto  #[YYYYMMDD], auto for no start limit
ssaraopt.endDate                     = auto  #[YYYYMMDD], auto for today
ssaraopt.parallel                    = 6  #[int], auto for 6, parallel download queries
#ssaraopt.excludeSeason               = 1015-0615  # MMDD-MMDD, exclude data between Oct 15 and June 15
#ssaraopt.beamMode                    = SM3  #[SM1 / SM2 / SM3 / WD1 / ...], omit to search all beam modes
#ssaraopt.collectionName              = ""  # ssara collection; omit to search ASF
######################################################
acquisition_mode                     = stripmap  #[stripmap], ALOS-2 stack prefix
######################################################
alos2Stack.slcDir                    = auto  #[path], auto for SLC/
alos2Stack.demDir                    = auto  #[path], auto for DEM/ from minsarApp
alos2Stack.boundingBox               = 0 0 0 0  #[S N W E], filled from the AOI
alos2Stack.referenceDate             = auto  #[YYYYMMDD / YYMMDD], auto for the first SLC date
alos2Stack.workflow                  = auto  #[auto / slc], auto for the full stack; slc stops before MintPy
alos2Stack.waterBody                 = auto  #[path / auto], auto for the *.wbd file next to the DEM
alos2Stack.polarization              = HH  #[HH / HV / VH / VV], auto for HH
alos2Stack.numberOfSubsequentDates   = 4  #[int], auto for 4, pair each date with this many later dates
alos2Stack.doIonosphere              = False  #[True / False], auto for False, estimate ionospheric phase
alos2Stack.applyIonosphere           = False  #[True / False], auto for False, apply the ionospheric correction
alos2Stack.startingSwath             = auto  # auto for the swaths that cover the AOI
alos2Stack.endingSwath               = auto  # auto for the swaths that cover the AOI; set both or neither
alos2Stack.rangeLooks                = 5  #[int], final range looks, ~60-90 m ground range (far-near swath). ISCE ScanSAR default (auto): 5 = 1 x 5
alos2Stack.azimuthLooks              = 28  #[multiple of 14], final azimuth looks, ~73 m; pixel ~60-90 by 73 m. ISCE ScanSAR default (auto): 28 = 14 x 2
alos2Stack.unwMethod                 = auto  #[snaphu / whirlwind], auto for whirlwind, unwrapper of run_15_unwrap
######################################################
mintpy.subset.lalo                   = 0:0,0:0    #[S:N,W:E / no], auto for no
mintpy.load.autoPath                 = yes   # [yes / no], auto for no, use pre-defined auto path
minsar.mintpyDir.addition            = date  #[name / lalo / no] auto for no (miaply_$name_startDate_endDate))
mintpy.compute.cluster               = local #[local / slurm / pbs / lsf / none], auto for none, cluster type
mintpy.compute.numWorker             = 48 #[int > 1 / all], auto for 4 (local) or 40 (non-local), num of workers
mintpy.compute.maxMemory             = auto  #[float > 0.0], auto for 4, max memory to allocate in GB
mintpy.plot.maxMemory                = 0.2  #[float], auto for 4, max memory used by one call of view.py for plotting.
mintpy.plot                          = no  #[yes / no], auto for yes; create_template may set yes if ssaraopt span <= 365 days
mintpy.networkInversion.parallel     = yes  #[yes / no], auto for no, parallel processing using dask
mintpy.save.hdfEos5                  = yes   #[yes / update / no], auto for no, save timeseries to UNAVCO InSAR Archive format
mintpy.save.hdfEos5.update           = yes   #[yes / no], auto for no, XXXXXXXX end date if last date is within 31 days of today
mintpy.save.hdfEos5.subset           = yes   #[yes / no], auto for no, put subset range info in output filename
mintpy.save.kmz                      = yes   #[yes / no], auto for yes, save geocoded velocity to Google Earth KMZ file
mintpy.reference.minCoherence        = 0.7      #[0.0-1.0], auto for 0.85, minimum coherence for auto method
mintpy.troposphericDelay.method      = auto   # pyaps  #[pyaps / height_correlation / base_trop_cor / no], auto for pyaps
mintpy.networkInversion.minTempCoh   = 0.6 #[0.0-1.0], auto for 0.7, min temporal coherence for mask
mintpy.deramp                        = linear  #[no / linear / quadratic], auto for no - no ramp will be removed
######################################################
miaplpy.load.autoPath                 = yes   # [yes / no], auto for no, use pre-defined auto path
miaplpy.load.processor               = isce
miaplpy.multiprocessing.numProcessor = 40
miaplpy.inversion.rangeWindow        = 24   # range window size for searching SHPs, auto for 15
miaplpy.inversion.azimuthWindow      = 7    # azimuth window size for searching SHPs, auto for 15
miaplpy.inversion.patchSize          = 150  # patch size (n*n) to divide the image for parallel processing, auto for 200
miaplpy.timeseries.tempCohType       = full     # [full, average], auto for full.
miaplpy.interferograms.networkType   = delaunay # network
miaplpy.unwrap.snaphu.tileNumPixels  = 10000000000     # number of pixels in a tile, auto for 10000000
######################################################
minsar.mintpyDir.addition            = date  #[name / lalo / no] auto for no (miaply_$name_startDate_endDate))
minsar.miaplpyDir.addition           = date  #[name / lalo / no] auto for no (miaply_$name_startDate_endDate))
miaplpy.subset.lalo                  = 0:0,0:0    #[S:N,W:E / no], auto for no
miaplpy.load.startDate               = auto  # 20200101
miaplpy.load.endDate                 = auto
#mintpy.geocode.laloStep              = 0.0008,0.0008
miaplpy.timeseries.minTempCoh        = 0.55      # auto for 0.5
mintpy.networkInversion.minTempCoh   = 0.55
######################################################
minsar.insarmaps_flag                = True
minsar.upload_flag                   = True
minsar.insarmaps_dataset             = geo
minsar.product.suffix                = auto
