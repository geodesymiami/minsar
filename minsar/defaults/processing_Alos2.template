######################################################
ssaraopt.platform                    = ALOS2  #[ALOS2 / ALOS-2], download and stack sensor
ssaraopt.relativeOrbit               = 0  #[int], filled from coverage for the AOI
ssaraopt.startDate                   = auto  #[YYYYMMDD], auto for no start limit
ssaraopt.endDate                     = auto  #[YYYYMMDD], auto for today
ssaraopt.parallel                    = 6  #[int], auto for 6, parallel download queries
#ssaraopt.excludeSeason               = 1015-0615  # MMDD-MMDD, exclude data between Oct 15 and June 15
#ssaraopt.beamMode                    = SM3  #[SM1 / SM2 / SM3 / WD1 / ...], omit to search all beam modes
#ssaraopt.collectionName              = ""  # ssara collection; omit to search ASF
######################################################
acquisition_mode                     = stripmap  #[stripmap], ALOS-2 stack prefix
######################################################
alos2Stack.slcDir                    = auto  #[path], auto for SLC/
alos2Stack.demDir                    = auto  #[path], auto for DEM/ from minsarApp
alos2Stack.boundingBox               = 0 0 0 0  #[S N W E], filled from the AOI
alos2Stack.referenceDate             = auto  #[YYYYMMDD / YYMMDD], auto for the first SLC date
alos2Stack.workflow                  = auto  #[auto / slc], auto for the full stack; slc stops before MintPy
alos2Stack.waterBody                 = auto  #[path / auto], auto for the *.wbd file next to the DEM
alos2Stack.polarization              = HH  #[HH / HV / VH / VV], auto for HH
alos2Stack.numberOfSubsequentDates   = 4  #[int], auto for 4, pair each date with this many later dates
alos2Stack.doIonosphere              = False  #[True / False], auto for False, estimate ionospheric phase
alos2Stack.applyIonosphere           = False  #[True / False], auto for False, apply the ionospheric correction
alos2Stack.startingSwath             = auto  #[int], auto for the swaths that cover the AOI
alos2Stack.endingSwath               = auto  #[int], auto for the swaths that cover the AOI; set both or neither
######################################################
mintpy.subset.lalo                   = 0:0,0:0  #[S:N,W:E / no], auto for no
mintpy.load.autoPath                 = auto  #[yes / no], auto for no, use pre-defined auto path
minsar.mintpyDir.addition            = auto  #[name / lalo / date / no], auto for mintpy
mintpy.compute.cluster               = auto  #[local / slurm / pbs / lsf / none], auto for none, cluster type
mintpy.compute.numWorker             = auto  #[int > 1 / all], auto for 4 (local) or 40 (non-local), num of workers
mintpy.compute.maxMemory             = auto  #[float > 0.0], auto for 4, max memory to allocate in GB
mintpy.plot.maxMemory                = auto  #[float], auto for 4, max memory used by one call of view.py for plotting
mintpy.plot                          = auto  #[yes / no], auto for yes, plot files generated by default processing to pic folder
mintpy.networkInversion.parallel     = auto  #[yes / no], auto for no, parallel processing using dask
mintpy.networkInversion.minTempCoh   = auto  #[0.0-1.0], auto for 0.7, min temporal coherence for mask
mintpy.reference.minCoherence        = auto  #[0.0-1.0], auto for 0.85, minimum coherence for auto method
mintpy.troposphericDelay.method      = auto  #[pyaps / height_correlation / base_trop_cor / no], auto for pyaps
mintpy.geocode.laloStep              = auto  #[float,float / none], auto for none
mintpy.save.hdfEos5                  = auto  #[yes / update / no], auto for no, save timeseries to UNAVCO InSAR Archive format
mintpy.save.hdfEos5.update           = auto  #[yes / no], auto for no, put XXXXXXXX as endDate in output filename
mintpy.save.hdfEos5.subset           = auto  #[yes / no], auto for no, put subset range info in output filename
mintpy.save.kmz                      = auto  #[yes / no], auto for yes, save geocoded velocity to Google Earth KMZ file
######################################################
minsar.insarmaps_flag                = False  #[True / False], auto for False
minsar.upload_flag                   = True  #[True / False], auto for True, upload products
minsar.insarmaps_dataset             = auto  #[DS / filt*DS / geo], used when insarmaps is on
minsar.product.suffix                = auto  #[auto / no / coherenceThreshold / TAG], auto for no extra suffix
